# CMS API origin (the client calls /public/* below this origin)
VITE_API_URL=https://cms-api.hanbeyoglu.com

# Copy these public API settings from Modern CMS Developer API settings.
# The public key is designed for browser use; restrict its allowed domains in CMS.
VITE_CMS_PUBLIC_API_KEY=
VITE_CMS_TENANT_ID=
VITE_CMS_MALL_ID=
VITE_CMS_LOCALE=tr

# Google Maps embed (optional)
VITE_GOOGLE_MAPS_API_KEY=

# App environment
VITE_APP_ENV=development
